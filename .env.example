# Copie para .env e ajuste (docker compose lê automaticamente)
# URL que a TV/app usa na rede de casa (IP do PC + porta)
JELLYFIN_PUBLISHED_SERVER_URL=http://192.168.1.100:8096

# Pasta de mídia no host (caminho absoluto)
# macOS/Linux: /Users/voce/Media ou /home/voce/Media
# Windows: C:/Media
MEDIA_PATH=
